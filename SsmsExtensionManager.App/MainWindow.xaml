<Window x:Class="SsmsExtensionManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SSMS Extension Manager" Height="720" Width="1180"
        MinHeight="620" MinWidth="980"
        Loaded="Window_Loaded"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Install VSIX/ZIP" Click="InstallLocal_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Click="Refresh_Click" />
                <MenuItem Header="_Update All" Click="UpdateAll_Click" />
                <Separator />
                <MenuItem Header="_Settings" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="_Selection">
                <MenuItem x:Name="SelectionUpdateMenuItem" Header="_Update" Click="UpdateSelected_Click" />
                <MenuItem x:Name="SelectionReinstallMenuItem" Header="_Reinstall" Click="Reinstall_Click" />
                <MenuItem x:Name="SelectionSetSourceMenuItem" Header="Set _Source" Click="SetSource_Click" />
                <MenuItem x:Name="SelectionUninstallMenuItem" Header="_Uninstall" Click="Uninstall_Click" />
                <Separator />
                <MenuItem x:Name="SelectionRemoveMenuItem" Header="Re_move from List" Click="RemoveFromList_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Application Updates" Click="CheckApplicationUpdates_Click" />
                <Separator />
                <MenuItem Header="_Help" Click="Help_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="18"
              TextElement.Foreground="{DynamicResource ControlForegroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock Text="SSMS Extension Manager" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Third-party SSMS extensions are not officially supported by Microsoft. Install only extensions you trust."
                           Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      x:Name="ExtensionsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionChanged="ExtensionsGrid_SelectionChanged"
                      PreviewMouseLeftButtonDown="ExtensionsGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="ExtensionsGrid_PreviewMouseRightButtonDown"
                      PreviewMouseRightButtonUp="ExtensionsGrid_PreviewMouseRightButtonUp"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                                <Setter Property="Background" Value="{DynamicResource UnavailableRowBackgroundBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Extension" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="ExtensionNameText"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock x:Name="ExtensionNameLink"
                                               Visibility="Collapsed">
                                        <Hyperlink Click="ExtensionLink_Click">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding GitHubUri}" Value="{x:Null}">
                                        <Setter TargetName="ExtensionNameText" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ExtensionNameLink" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasGitHubUri}" Value="True">
                                        <Setter TargetName="ExtensionNameText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ExtensionNameLink" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.1*" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="100" />
                    <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="100" />
                    <DataGridTextColumn Header="Update Source" Binding="{Binding UpdateSourceText}" Width="2*" />
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Popup Grid.Row="1"
                   x:Name="RowActionsPopup"
                   AllowsTransparency="True"
                   Placement="RelativePoint"
                   PlacementTarget="{Binding ElementName=ExtensionsGrid}"
                   PopupAnimation="Fade"
                   StaysOpen="True">
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinWidth="160"
                        Padding="3"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Direction="270"
                                          Opacity="0.18"
                                          ShadowDepth="2"
                                          Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="RowUpdateButton"
                                Content="Update"
                                Tag="Update"
                                Style="{StaticResource RowActionButtonStyle}"
                                Click="UpdateSelected_Click" />
                        <Button x:Name="RowReinstallButton"
                                Content="Reinstall"
                                Tag="Reinstall"
                                Style="{StaticResource RowActionButtonStyle}"
                                Click="Reinstall_Click" />
                        <Button x:Name="RowSetSourceButton"
                                Content="Set Source"
                                Tag="SetSource"
                                Style="{StaticResource RowActionButtonStyle}"
                                Click="SetSource_Click" />
                        <Button x:Name="RowUninstallButton"
                                Content="Uninstall"
                                Tag="Uninstall"
                                Style="{StaticResource RowActionButtonStyle}"
                                Click="Uninstall_Click" />
                        <Border x:Name="RowRemoveSeparator"
                                Height="1"
                                Margin="6,3"
                                Background="{DynamicResource GridLineBrush}" />
                        <Button x:Name="RowRemoveButton"
                                Content="Remove from List"
                                Tag="Remove"
                                Style="{StaticResource RowActionButtonStyle}"
                                Click="RemoveFromList_Click" />
                    </StackPanel>
                </Border>
            </Popup>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <ProgressBar DockPanel.Dock="Right"
                             x:Name="BusyProgress"
                             Width="180"
                             Height="16"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedForegroundBrush}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
