<Window x:Class="SsmsExtensionManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="SSMS Extension Manager" Height="724.8" Width="1309.6"
        MinHeight="620" MinWidth="980"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostNavButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Active" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryActionPressedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryActionPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledControlBackgroundBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentRowActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentActionButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style x:Key="AppUpdateButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryActionForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,1" />
        </Style>

        <Style x:Key="LaunchActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource LaunchActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LaunchActionForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LaunchActionBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LaunchActionHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LaunchActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LaunchActionPressedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LaunchActionPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledControlBackgroundBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A4262C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionIconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeStartLineCap" Value="Square" />
            <Setter Property="StrokeEndLineCap" Value="Square" />
            <Setter Property="StrokeLineJoin" Value="Miter" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ViewModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtensionFilterHostStyle" TargetType="{x:Type Grid}">
            <Setter Property="Width" Value="330" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <ItemsPanelTemplate x:Key="ExtensionTilesItemsPanelTemplate">
            <WrapPanel IsItemsHost="True"
                       Background="{DynamicResource AppBackgroundBrush}" />
        </ItemsPanelTemplate>

        <ControlTemplate x:Key="ExtensionTilesListBoxTemplate" TargetType="{x:Type ListBox}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              Background="{TemplateBinding Background}">
                    <ItemsPresenter />
                </ScrollViewer>
            </Border>
        </ControlTemplate>

        <Style x:Key="ExtensionTilesListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template" Value="{StaticResource ExtensionTilesListBoxTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource ExtensionTilesItemsPanelTemplate}" />
        </Style>

        <Style x:Key="ExtensionTileItemContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="330" />
            <Setter Property="MinHeight" Value="238" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManageExtensionTileItemContainerStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ExtensionTileItemContainerStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource UnavailableRowBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                    <Setter Property="Opacity" Value="0.82" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExtensionListColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style x:Key="ExtensionListGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ExtensionListColumnHeaderStyle}" />
        </Style>

        <Style x:Key="ExtensionListRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManageExtensionListRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource UnavailableRowForegroundBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Background" Value="{DynamicResource UnavailableRowBackgroundBrush}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Grid DockPanel.Dock="Top"
              Height="36"
              Background="{DynamicResource ControlBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="Assets/ssms-extension-manager.ico"
                   Width="20"
                   Height="20"
                   Margin="20,8,12,0"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False" />

            <Menu x:Name="MainMenu"
                  Grid.Column="1"
                  Margin="0,8,0,0"
                  VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="_File">
                    <MenuItem Header="_Install VSIX/ZIP" Click="InstallLocal_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Refresh" Click="Refresh_Click" />
                    <MenuItem Header="_Update All" Click="UpdateAll_Click" />
                    <Separator />
                    <MenuItem Header="_Settings" Click="Settings_Click" />
                    <MenuItem Header="Edit Settings as _JSON" Click="EditSettingsJson_Click" />
                </MenuItem>
                <MenuItem Header="_Selection">
                    <MenuItem x:Name="SelectionUpdateMenuItem" Header="_Update" Click="UpdateSelected_Click" />
                    <MenuItem x:Name="SelectionReinstallMenuItem" Header="_Reinstall" Click="Reinstall_Click" />
                    <MenuItem x:Name="SelectionSetSourceMenuItem" Header="Edit _Source" Click="SetSource_Click" />
                    <MenuItem x:Name="SelectionUninstallMenuItem" Header="_Uninstall" Click="Uninstall_Click" />
                    <Separator />
                    <MenuItem x:Name="SelectionRemoveMenuItem" Header="Re_move from List" Click="RemoveFromList_Click" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Check for Application Updates" Click="CheckApplicationUpdates_Click" />
                    <Separator />
                    <MenuItem Header="_Help" Click="Help_Click" />
                </MenuItem>
            </Menu>

            <TextBlock x:Name="TitleBarTitleText"
                       Grid.Column="2"
                       Text="SSMS Extension Manager"
                       HorizontalAlignment="Center"
                       Margin="0,9,0,0"
                       VerticalAlignment="Top"
                       FontSize="12.5"
                       Foreground="{DynamicResource TitleBarForegroundBrush}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="0,7,0,0"
                        VerticalAlignment="Top">
                <Button x:Name="UpdateAppButton"
                        Style="{StaticResource AppUpdateButtonStyle}"
                        Visibility="Collapsed"
                        Click="UpdateAppButton_Click"
                        ToolTip="Application update available"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="UpdateAppButtonText"
                               Text="Update"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>

                <Button x:Name="LaunchSsmsButton"
                        Style="{StaticResource LaunchActionButtonStyle}"
                        Content="Launch SSMS"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Click="LaunchSsms_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>

            <StackPanel x:Name="WindowButtonsPanel"
                        Grid.Column="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0"
                        VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeWindowButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Minimize"
                        Click="MinimizeWindow_Click">
                    <Path Style="{StaticResource CaptionIconPathStyle}"
                          Data="{StaticResource MinimizeIconGeometry}" />
                </Button>

                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Maximize"
                        Click="MaximizeWindow_Click">
                    <Path x:Name="MaximizeWindowIcon"
                          Style="{StaticResource CaptionIconPathStyle}"
                          Data="M 1 1 L 9 1 L 9 9 L 1 9 Z" />
                </Button>

                <Button x:Name="CloseWindowButton"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Click="CloseWindow_Click">
                    <Path Style="{StaticResource CaptionIconPathStyle}"
                          Data="{StaticResource CloseIconGeometry}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid TextElement.Foreground="{DynamicResource ControlForegroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationPanel"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Padding="12,14"
                    Margin="0">
                <StackPanel>
                    <Button x:Name="ManageNavButton"
                            Style="{StaticResource GhostNavButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="ManageNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M48,244.8l126-126c0.7-0.7,1.4-1.5,2.1-2.3c20.3,6.8,43.6,2.1,59.8-14.1c17.5-17.5,21.6-43.3,12.2-64.7l-38.5,38.5 l-30.2-30.2l38.5-38.5c-21.4-9.3-47.2-5.2-64.7,12.2c-16.2,16.2-20.9,39.5-14.1,59.8c-0.8,0.6-1.6,1.3-2.3,2.1l-126,126 c-10.2,10.2-10.2,27,0,37.2l0,0C21,255,37.7,255,48,244.8z" />
                            <TextBlock Text="Manage" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BrowseNavButton"
                            Style="{StaticResource GhostNavButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="BrowseNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M6,2.2 A3.8,3.8 0 1 1 5.999,2.2 M8.7,8.7 L12.5,12.5" />
                            <TextBlock Text="Browse" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton"
                            Style="{StaticResource GhostNavButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
