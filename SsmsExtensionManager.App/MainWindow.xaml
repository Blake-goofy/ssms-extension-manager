                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"
                  Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PageHeaderPanel"
                            Grid.Row="0"
                            Orientation="Vertical"
                            Margin="0,0,0,12">
                    <TextBlock x:Name="PageTitleText" Text="SSMS Extension Manager" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText"
                               Text="Third-party SSMS extensions are not officially supported by Microsoft. Install only extensions you trust."
                               Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid x:Name="ViewHost" Grid.Row="1">
                    <Grid x:Name="ManageView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Grid Style="{StaticResource ExtensionFilterHostStyle}">
                                <TextBox x:Name="ManageSearchTextBox"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="ManageSearchTextBox_TextChanged" />
                                <TextBlock x:Name="ManageSearchPlaceholderText"
                                           Text="Filter managed extensions"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Margin="14,0,0,0">
                                <Button x:Name="ManageTilesViewButton"
                                        Style="{StaticResource ViewModeButtonStyle}"
                                        ToolTip="Tile view"
                                        Click="ManageTilesViewButton_Click">
                                    <Path Width="14"
                                          Height="14"
                                          Stretch="Fill"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource TileViewIconGeometry}" />
                                </Button>
                                <Button x:Name="ManageListViewButton"
                                        Style="{StaticResource ViewModeButtonStyle}"
                                        Margin="-1,0,0,0"
                                        ToolTip="List view"
                                        Click="ManageListViewButton_Click">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{StaticResource ListViewIconGeometry}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="ManageTilesListBox"
                                 Grid.Row="1"
                                 Style="{StaticResource ExtensionTilesListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ManageExtensionTileItemContainerStyle}"
                                 SelectionMode="Extended"
                                 SelectionChanged="ManageTilesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="76"
                                                    Height="76"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    <Image Source="{Binding IconSource}"
                                                           Stretch="Uniform"
                                                           Margin="5"
                                                           SnapsToDevicePixels="True"
                                                           UseLayoutRounding="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"
                                                           ImageFailed="GalleryIcon_ImageFailed" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ControlForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="44" />
                                                <TextBlock Text="{Binding AuthorText}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VersionText}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                                <TextBlock Text="{Binding TimestampText}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           ToolTip="{Binding TimestampTooltipText}" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Width="30"
                                                    Height="26"
                                                    Padding="0"
                                                    ToolTip="Actions"
                                                    Click="ExtensionTileActions_Click">
                                                <Path Width="16"
                                                      Height="4"
                                                      Stretch="Uniform"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M2,2 A2,2 0 1 1 1.999,2 M8,2 A2,2 0 1 1 7.999,2 M14,2 A2,2 0 1 1 13.999,2" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Margin="0,14,0,14"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="76" />

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Open page"
                                                    Padding="10,5"
                                                    Margin="0,0,8,0"
                                                    IsEnabled="{Binding HasOpenUri}"
                                                    Click="OpenExtensionPage_Click" />
                                            <Button x:Name="TileReinstallButton"
                                                    Content="Reinstall"
                                                    Padding="10,5"
                                                    Margin="0,0,8,0"
                                                    Visibility="Collapsed"
                                                    Click="ReinstallExtensionTile_Click" />
                                            <Button x:Name="TileUpdateButton"
                                                    Content="Update"
                                                    Style="{StaticResource AccentActionButtonStyle}"
                                                    Padding="10,5"
                                                    Visibility="Collapsed"
                                                    Click="UpdateExtensionTile_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailableUpdate}" Value="True">
                                            <Setter TargetName="TileUpdateButton" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding CanReinstall}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TileReinstallButton" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DataGrid x:Name="ExtensionsGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource ExtensionListGridStyle}"
                                  RowStyle="{StaticResource ManageExtensionListRowStyle}"
                                  SelectionMode="Extended"
                                  SelectionChanged="ExtensionsGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="ExtensionsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="ExtensionsGrid_PreviewMouseRightButtonDown"
                                  PreviewMouseRightButtonUp="ExtensionsGrid_PreviewMouseRightButtonUp">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Extension" Width="1.5*" SortMemberPath="DisplayName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock x:Name="ExtensionNameText"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock x:Name="ExtensionNameLink"
                                                           Visibility="Collapsed">
                                                    <Hyperlink Click="ExtensionLink_Click">
                                                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding OpenUri}" Value="{x:Null}">
                                                    <Setter TargetName="ExtensionNameText" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="ExtensionNameLink" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasOpenUri}" Value="True">
                                                    <Setter TargetName="ExtensionNameText" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ExtensionNameLink" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="118" />
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1*" />
                                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="72" />
                                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="72" />
                                <DataGridTemplateColumn Header="Date/Time Stamp" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TimestampText}"
                                                       ToolTip="{Binding TimestampTooltipText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Update Source" Binding="{Binding UpdateSourceText}" Width="3.3*" />
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="78" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="BrowseView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <Grid Style="{StaticResource ExtensionFilterHostStyle}">
                                <TextBox x:Name="GallerySearchTextBox"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="GallerySearchTextBox_TextChanged" />
                                <TextBlock x:Name="GallerySearchPlaceholderText"
                                           Text="Filter gallery"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Margin="14,0,0,0">
                                <Button x:Name="BrowseTilesViewButton"
                                        Style="{StaticResource ViewModeButtonStyle}"
                                        ToolTip="Tile view"
                                        Click="BrowseTilesViewButton_Click">
                                    <Path Width="14"
                                          Height="14"
                                          Stretch="Fill"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="{StaticResource TileViewIconGeometry}" />
                                </Button>
                                <Button x:Name="BrowseListViewButton"
                                        Style="{StaticResource ViewModeButtonStyle}"
                                        Margin="-1,0,0,0"
                                        ToolTip="List view"
                                        Click="BrowseListViewButton_Click">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{StaticResource ListViewIconGeometry}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="GalleryListBox"
                                 Grid.Row="1"
                                 Style="{StaticResource ExtensionTilesListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ExtensionTileItemContainerStyle}"
                                 PreviewMouseRightButtonDown="GalleryListBox_PreviewMouseRightButtonDown"
                                 PreviewMouseRightButtonUp="GalleryListBox_PreviewMouseRightButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="76"
                                                    Height="76"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    <Image Source="{Binding IconSource}"
                                                           Stretch="Uniform"
                                                           Margin="5"
                                                           SnapsToDevicePixels="True"
                                                           UseLayoutRounding="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Unspecified"
                                                           ImageFailed="GalleryIcon_ImageFailed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="44" />
                                                <TextBlock Text="{Binding AuthorText}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VersionText}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Summary}"
                                                   Margin="0,14,0,14"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="76" />
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Open page"
                                                    Padding="10,5"
                                                    Margin="0,0,8,0"
                                                    IsEnabled="{Binding HasPageUri}"
                                                    Click="OpenGalleryPage_Click" />
                                            <Button Content="{Binding InstallButtonText}"
                                                    Style="{StaticResource AccentActionButtonStyle}"
                                                    Padding="10,5"
                                                    IsEnabled="{Binding CanInstall}"
                                                    Click="InstallGalleryExtension_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DataGrid x:Name="GalleryGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource ExtensionListGridStyle}"
                                  RowStyle="{StaticResource ExtensionListRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  SelectionMode="Single"
                                  PreviewMouseRightButtonDown="GalleryGrid_PreviewMouseRightButtonDown"
                                  PreviewMouseRightButtonUp="GalleryGrid_PreviewMouseRightButtonUp"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Extension" Binding="{Binding DisplayName}" Width="220" SortMemberPath="DisplayName" />
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Extension.Author}" Width="140" />
                                <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="86" />
                                <DataGridTextColumn Header="Status" Binding="{Binding InstallButtonText}" Width="92" />
                                <DataGridTemplateColumn Header="Summary" Width="SizeToCells" MinWidth="520">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="GalleryStatusText"
                                   Grid.Row="2"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="InstanceDropDownButton"
                                    Padding="8,5"
                                    HorizontalContentAlignment="Stretch"
                                    Click="InstanceDropDown_Click">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Right"
                                          Width="10"
                                          Height="6"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource MutedForegroundBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{StaticResource ChevronDownGeometry}" />
                                    <TextBlock x:Name="InstanceDropDownText"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Popup x:Name="InstanceDropDownPopup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=InstanceDropDownButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="True">
                                <Border Style="{StaticResource DropDownPopupBorderStyle}"
                                        MinWidth="{Binding ActualWidth, ElementName=InstanceDropDownButton}">
                                    <ListBox x:Name="InstanceListBox"
                                             Background="{DynamicResource PanelBackgroundBrush}"
                                             BorderThickness="0"
                                             DisplayMemberPath="Display"
                                             Foreground="{DynamicResource ControlForegroundBrush}"
                                             SelectionChanged="InstanceListBox_SelectionChanged"
                                             ItemContainerStyle="{StaticResource PopupMenuListBoxItemStyle}" />
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="SSMS launch executable path"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6" />

                        <Grid Grid.Row="2"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SsmsLaunchExecutablePathTextBox"
                                     MinWidth="520"
                                     MaxWidth="620"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SsmsLaunchSettings_TextChanged" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Margin="8,0,0,0"
                                    Padding="10,5"
                                    Click="BrowseSsmsLaunchExecutable_Click" />
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="Launch arguments"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6" />

                        <Grid Grid.Row="4"
                              HorizontalAlignment="Left">
                            <TextBox x:Name="SsmsLaunchArgumentsTextBox"
                                     MinWidth="520"
                                     MaxWidth="620"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SsmsLaunchSettings_TextChanged" />
                            <TextBlock x:Name="SsmsLaunchArgumentsPlaceholderText"
                                       Text="Example: -nosplash"
                                       Margin="5,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <CheckBox Grid.Row="5"
                                  x:Name="ShowMicrosoftExtensionsCheckBox"
                                  Content="_Show extensions published by Microsoft"
                                  Margin="0,18,0,0"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                        <CheckBox Grid.Row="6"
                                  x:Name="DarkThemeCheckBox"
                                  Content="_Dark theme"
                                  Margin="0,14,0,0"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                        <CheckBox Grid.Row="7"
                                  x:Name="CheckForAppUpdatesCheckBox"
                                  Content="Check for application _updates on startup"
                                  Margin="0,14,0,0"
                                  Checked="SettingsControl_Changed"
                                  Unchecked="SettingsControl_Changed" />

                    </Grid>
                </Grid>

                <Popup Grid.Row="1"
                       x:Name="RowActionsPopup"
                       AllowsTransparency="True"
                       Placement="RelativePoint"
                       PlacementTarget="{Binding ElementName=ManageView}"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Style="{StaticResource PopupMenuBorderStyle}"
                            MinWidth="160">
                        <StackPanel>
                            <Button x:Name="RowUpdateButton"
                                    Content="Update"
                                    Tag="Update"
                                    Style="{StaticResource AccentRowActionButtonStyle}"
                                    Click="UpdateSelected_Click" />
                            <Button x:Name="RowReinstallButton"
                                    Content="Reinstall"
                                    Tag="Reinstall"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="Reinstall_Click" />
                            <Button x:Name="RowSetSourceButton"
                                    Content="Edit Source"
                                    Tag="SetSource"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="SetSource_Click" />
                            <Button x:Name="RowUninstallButton"
                                    Content="Uninstall"
                                    Tag="Uninstall"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="Uninstall_Click" />
                            <Border x:Name="RowRemoveSeparator"
                                    Height="1"
                                    Margin="6,3"
                                    Background="{DynamicResource GridLineBrush}" />
                            <Button x:Name="RowRemoveButton"
                                    Content="Remove from List"
                                    Tag="Remove"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="RemoveFromList_Click" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup Grid.Row="1"
                       x:Name="GalleryActionsPopup"
                       AllowsTransparency="True"
                       Placement="RelativePoint"
                       PlacementTarget="{Binding ElementName=BrowseView}"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Style="{StaticResource PopupMenuBorderStyle}"
                            MinWidth="150">
                        <StackPanel>
                            <Button x:Name="GalleryInstallButton"
                                    Content="Install"
                                    Style="{StaticResource AccentRowActionButtonStyle}"
                                    Click="InstallGalleryExtension_Click" />
                            <Button x:Name="GalleryOpenPageButton"
                                    Content="Open page"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Click="OpenGalleryPage_Click" />
                        </StackPanel>
                    </Border>
                </Popup>

                <DockPanel Grid.Row="2" Margin="0,12,0,0" x:Name="FooterPanel">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="CancelBusyButton"
                                Content="Cancel"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="CancelBusy_Click" />
                        <ProgressBar x:Name="BusyProgress"
                                     Width="180"
                                     Height="16"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedForegroundBrush}" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
